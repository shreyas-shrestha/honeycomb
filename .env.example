# Get a key at https://platform.openai.com/api-keys and copy this file to .env.local
OPENAI_API_KEY=
# Optional: override the model (default gpt-6-luna; gpt-6.1-sol or gpt-6-astra are other options)
# HONEYCOMB_MODEL=gpt-6-astra

# Database. Leave these unset locally: the app uses a SQLite file at data/honeycomb.db.
# When deployed (for example on Vercel) set both to a Turso database, from https://turso.tech
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Set to 1 only when the app runs behind a proxy you control, so rate limits can use the caller's address.
# TRUST_PROXY=1
